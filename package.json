{
  "name": "property-manager",
  "version": "4.0.0",
  "description": "make it easier to manage the properties/attributes of your class.",
  "license": "MIT",
  "homepage": "https://github.com/snowyu/property-manager.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/snowyu/property-manager.js.git"
  },
  "bugs": {
    "url": "https://github.com/snowyu/property-manager.js/issues"
  },
  "keywords": [
    "attribute",
    "property",
    "properties",
    "manage",
    "manager",
    "ability",
    "object",
    "class",
    "json",
    "serialization",
    "deserialization"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "source": "./src/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "README.md",
    "LICENSE-MIT",
    "*.js",
    "*.json",
    "test",
    "src",
    "lib"
  ],
  "scripts": {
    "build": "tsup && npm run doc.md",
    "build.ts.d": "tsc --declaration --emitDeclarationOnly --outDir types",
    "clean": "rm -fr web docs types lib",
    "doc": "typedoc --plugin none --out web ./src",
    "doc.md": "typedoc --plugin typedoc-plugin-markdown --out docs ./src",
    "lint": "npx eslint src",
    "lint.fix": "npm run lint -- --fix",
    "release": "npm run clean && npm run build && git add docs && git ci -m 'docs: update API docs' && npx commit-and-tag-version -s",
    "release.alpha": "npm run release -- --prerelease alpha",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "custom-ability": "^2.3.1",
    "deep-equal": "^2.2.3",
    "inherits-ex": "^2.2.2",
    "util-ex": "^2.7.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-tsdoc": "^0.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "contributors": [
    {
      "name": "Riceball LEE",
      "email": "snowyu.lee@gmail.com",
      "url": "https://github.com/snowyu"
    }
  ],
  "maintainers": [
    {
      "name": "Riceball LEE",
      "email": "snowyu.lee@gmail.com"
    }
  ],
  "pre-commit": [
    "test"
  ]
}
